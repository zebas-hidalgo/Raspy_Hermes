graph LR
    %% Component Diagram - Warden Core Agent
    %% Subcomponentes y servicios internos de Warden

    classDef core fill:#f1f5f9,stroke:#475569,stroke-width:2px,color:#0f172a
    classDef skills fill:#fee2e2,stroke:#dc2626,stroke-width:1.5px,color:#991b1b
    classDef sys fill:#dbeafe,stroke:#2563eb,stroke-width:1.5px,color:#1e40af
    classDef bk fill:#e0e7ff,stroke:#4338ca,stroke-width:1.5px,color:#312e81

    subgraph "Warden Core Engine"
        HealthCoordinator["System Health Coordinator"]:::core
        MethodologyWarden["W.A.R.D.E.N. Protocol Engine"]:::core
        TriageEngine["Incident Triage & Root Cause Analyzer"]:::core
    end

    subgraph "Specialized Maintenance Skills (3)"
        SkillSysMaint["system_maintenance Executor"]:::skills
        SkillMaintenance["maintenance Routine Handler"]:::skills
        SkillWardenCore["warden Anomaly Detector"]:::skills
    end

    subgraph "OS Host Probes & Cleaners"
        DiskCleaner["Disk & Temp Space Pruner"]:::sys
