    end

    subgraph "Backup & Integrity Layer"
        BackupVerifier["3-2-1 Backup Integrity Verifier"]:::bk
        DBVacuumService["SQLite WAL & State Vacuum Worker"]:::bk
    end

    HealthCoordinator --> MethodologyWarden
