direction: down

# Nodos principales
capa: "Capa\n/capa" { style.fill: "#004488"; color: "#00d9ff" }
elektra: "Elektra\n/elektra" { style.fill: "#882200"; color: "#ff6b35" }
bio: "Bio\n/bio" { style.fill: "#105515"; color: "#2ecc71" }
caraxes: "Caraxes\n/caraxes" { style.fill: "#441066"; color: "#9b59b6" }
daemon: "Daemon\n/skill-creator" { style.fill: "#775500"; color: "#f39c12" }
warden: "Warden\n/warden" { style.fill: "#223344"; color: "#3498db" }
master: "Master\n(orquestacion)" { style.fill: "#774400"; color: "#f39c12" }
tutor: "Tutor\nConversion" { style.fill: "#105533"; color: "#1abc9c" }

gateway: "Gateway" { shape: cylinder; style.fill: "#2c3e50"; color: "#00d9ff" }
nim: "NVIDIA NIM" { shape: cloud; style.fill: "#76b900"; color: "#ffffff" }
ollama: "Ollama\nLocal" { shape: cylinder; style.fill: "#27ae60"; color: "#ffffff" }
peer: "Peer" { shape: diamond; style.fill: "#8e44ad"; color: "#ffffff" }

# CONEXIONES
gateway -> capa: "Rutea /capa"
gateway -> elektra: "Rutea /elektra"
gateway -> bio: "Rutea /bio"
gateway -> caraxes: "Rutea /caraxes"
gateway -> daemon: "Rutea /skill-creator"
gateway -> warden: "Rutea /warden"
gateway -> master: "Rutea master"
gateway -> tutor: "Rutea tutor"

capa -> gateway: "Respuesta"
elektra -> gateway: "Respuesta"
bio -> gateway: "Respuesta"
caraxes -> gateway: "Skills"
daemon -> gateway: "Skills"
warden -> gateway: "Alertas"
master -> gateway: "Orquesta"
tutor -> gateway: "Agent listo"

caraxes -> capa: "diseña" { style.stroke-dash: 5 }
caraxes -> elektra: "diseña" { style.stroke-dash: 5 }
caraxes -> bio: "diseña" { style.stroke-dash: 5 }

daemon -> capa: "crea/gestiona" { style.stroke: "#f39c12" }
daemon -> elektra: "crea/gestiona" { style.stroke: "#f39c12" }
daemon -> bio: "crea/gestiona" { style.stroke: "#f39c12" }

master -> capa: "orquesta" { style.bold: true; style.stroke-width: 2 }
master -> elektra: "orquesta" { style.bold: true }
master -> bio: "orquesta" { style.bold: true }

warden -> capa: "mantiene" { style.stroke-dash: 5; dir: both }
warden -> elektra: "mantiene" { style.stroke-dash: 5; dir: both }
warden -> bio: "mantiene" { style.stroke-dash: 5; dir: both }

capa -> nim: "Usa modelo" { style.stroke: "#76b900" }
elektra -> nim: "Usa modelo" { color: "#76b900" }
bio -> nim: "Usa modelo" { color: "#76b900" }

capa -> ollama: "Fallback" { style.stroke-dash: 5; color: "#27ae60" }
elektra -> ollama: "Fallback" { style.stroke-dash: 5; color: "#27ae60" }
bio -> ollama: "Fallback" { style.stroke-dash: 5; color: "#27ae60" }

master -> peer: "Cross-machine" { style.stroke-dash: 5 }
capa -> peer: "Cross-machine DM" { style.stroke-dash: 5 }