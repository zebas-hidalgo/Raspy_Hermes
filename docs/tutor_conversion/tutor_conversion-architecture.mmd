graph TD
    %% C4 Container Diagram - Tutor Conversion (Pedagogical Agent Converter)
    %% Arquitectura técnica del agente Tutor Conversion

    %% Estilos
    classDef user fill:#e8f4fd,stroke:#2e5aa8,stroke-width:2px,color:#1a3a5c
    classDef gateway fill:#fff3e0,stroke:#eb6c36,stroke-width:2px,color:#7a3d0e
    classDef agent fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b
    classDef nim fill:#e8f5e9,stroke:#22c55e,stroke-width:2px,color:#15803d
    classDef ped fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef lms fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#334155

    %% Actores y canales
    Educator[("👤 Docente / Diseñador Curricular\n(Creador Pedagógico)")]:::user
    Discord[("💬 Discord / Telegram\nGateway Bot")]:::gateway
    TeacherPortal[("🌐 Kronos Teacher Studio\nPortal Pedagógico")]:::gateway

    %% Hermes Gateway
    subgraph "Hermes Gateway"
        direction TB
        Gateway["🚪 Hermes Gateway\nRouter + Auth + Media Pipeline\n(Carga de PDFs y Guías)"]:::gateway
    end

    %% Núcleo Agente Tutor Conversion
    subgraph "Agente Tutor Conversion - Core"
        direction TB
        TutorCore["🎓 Tutor Conversion Core\nEl Alquimista Pedagógico\n(Metodología T.R.A.N.S.F.O.R.M.A.)"]:::agent
        PedagogicalStack["📦 Pedagogical Skills Stack\n• tutor_conversion_workflow (núcleo)\n• instructional-design-engine (Bloom/ZDP)\n• rubric-and-assessment-generator\n• educational-prompt-synthesizer"]:::agent
    end

    %% Modelos LLM
    subgraph "Modelos LLM"
        direction TB
        NIM["☁️ NVIDIA NIM Cloud\nNemotron-3-Ultra / Llama 3.1\n(Comprensión de Textos y Transmutación)"]:::nim
        Ollama["🏠 Ollama Local\nModelos en Raspberry Pi\n(Modo Offline)"]:::nim
    end

    %% Motor Pedagógico y Andamiaje
    subgraph "Diseño Instruccional & Estándares"
        direction TB
        TaxonomyEngine["🎯 Bloom & ZDP Analyzer\nIdentificación de verbos y progresión cognitiva"]:::ped
        ScaffoldingSystem["🪜 Scaffolding & Prompt Engine\nEstructuración socrática paso a paso"]:::ped
        RubricBuilder["📊 Rubric & Quiz Synthesizer\nEvaluaciones formativas y listas de cotejo"]:::ped
    end

    %% Salidas y Agentes Generados
    subgraph "Agentes Educativos Generados & LMS"
        direction TB
        NewAgents["🤖 Nuevos Bots Docentes\nPerfiles generados en ~/.hermes/profiles/"]:::lms
        LMSSync["🏫 LMS Connector\nGoogle Classroom / Moodle / H5P"]:::lms
        DossierStore["📚 Dossiers & PDFs Pedagógicos\nGuías para el aula"]:::lms
    end

    %% Relaciones
    Educator -->|"/tutor o carga de PDF de clase"| Discord
    Educator -->|"Diseño de agentes de asignatura"| TeacherPortal
    Discord --> Gateway
    TeacherPortal --> Gateway
    Gateway -->|"/tutor route"| TutorCore
    TutorCore <--> PedagogicalStack
    TutorCore -->|Inferencia pedagógica| NIM
    NIM -.->|Fallback local| Ollama

    PedagogicalStack --> TaxonomyEngine
    TaxonomyEngine --> ScaffoldingSystem
    ScaffoldingSystem --> RubricBuilder

    PedagogicalStack -->|Desplegar nuevo bot| NewAgents
    PedagogicalStack -->|Exportar actividades| LMSSync
    PedagogicalStack -->|Guardar guías imprimibles| DossierStore
